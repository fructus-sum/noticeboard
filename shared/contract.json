{
  "_comment": "Values the server and both web apps must agree on (see shared/index.js). PUBLIC VALUES ONLY: the web apps build this into the JavaScript every browser downloads, and the repository is public. Never put secrets, Pi file paths or anything from data/ here.",
  "socketEvents": {
    "DISPLAY_READY": "display:ready",
    "PLAYLIST_UPDATE": "playlist:update",
    "DISPLAY_BUILD": "display:build",
    "DISPLAY_SETTINGS": "display:settings"
  },
  "limits": {
    "passwordMinLength": 8,
    "slideSeconds": { "min": 1, "max": 3600 },
    "mediaNameMax": 200
  },
  "display": {
    "defaultBackground": "#000000",
    "colourPattern": "^#[0-9a-fA-F]{6}$",
    "videoFormats": ["h265", "h264"],
    "defaultVideoFormat": "h265"
  },
  "audio": {
    "orders": ["in-order", "shuffle"],
    "transitions": ["none", "crossfade"],
    "fadeSeconds": { "min": 1, "max": 10, "default": 3 },
    "volume": { "min": 0, "max": 100, "default": 100 }
  }
}
