{
  "name": "noticeboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client/display",
    "client/admin"
  ],
  "scripts": {
    "build": "npm -w noticeboard-display run build && npm -w noticeboard-admin run build",
    "start": "node server/index.js",
    "test": "node tests/run.js unit",
    "test:api": "node tests/run.js api",
    "test:browser": "node tests/run.js browser",
    "test:installers": "node tests/run.js installers",
    "test:upgrade": "node tests/run.js upgrade",
    "test:all": "node tests/run.js all",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
