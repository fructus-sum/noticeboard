# The environment for the noticeboard service. On a Pi the installer writes /opt/noticeboard/.env,
# which systemd loads (EnvironmentFile=): the file must exist. The port, password and MAC list
# live in data/config.json (Settings in the admin panel).

# Set to 'true' ONLY if serving over HTTPS (e.g. behind a reverse proxy with TLS).
# Pi installs use plain HTTP on a local network — leave this false.
SECURE_COOKIES=false

# Troubleshooting: 'debug' also logs each MAC lookup and other details. Leave unset normally.
# NOTICEBOARD_LOG_LEVEL=debug
